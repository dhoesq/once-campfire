<%# Rendered once, before the first unread message. Carries no data-message-id
    so the message paginator's IntersectionObserver ignores it, and no .message
    class so the client-side formatter skips it. %>
<div class="messages__new-divider" role="separator" aria-label="New messages">
  <span class="messages__new-divider-label">New messages</span>
</div>
