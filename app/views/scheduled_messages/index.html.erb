<% @page_title = "Scheduled" %>
<% @body_class = "sidebar scheduled-messages" %>

<%# Keep the standard turbo_permanent user_sidebar frame so the main nav stays
    live and the badge-dot / rooms-list hooks are preserved (mirrors bookmarks). %>
<% content_for :sidebar, sidebar_turbo_frame_tag(src: user_sidebar_path) %>

<% content_for :nav do %>
  <div class="scheduled-messages__title flex align-center gap pad-block-start-half">
    <%= tag.div class: "btn btn--reversed btn--faux align-center gap txt-nowrap" do %>
      <%= image_tag "clock.svg", size: 18, aria: { hidden: "true" } %>
      <span class="overflow-ellipsis">Scheduled messages</span>
      <span class="flex-item-no-shrink"><%= @scheduled_messages.size %></span>
    <% end %>
  </div>
<% end %>

<div id="message-area" class="message-area">
  <% if @scheduled_messages.any? %>
    <div id="scheduled-messages-list" class="messages scheduled-messages__results flex flex-column gap">
      <%= render partial: "scheduled_messages/scheduled_message", collection: @scheduled_messages, as: :scheduled_message %>
    </div>
  <% else %>
    <div class="message-area--empty min-width center">
      <figure class="center pad">
        <%= image_tag "clock.svg", aria: { hidden: "true" }, class: "colorize--black translucent" %>
      </figure>
      <p class="txt-large txt-subtle center">No scheduled messages</p>
    </div>
  <% end %>
</div>
