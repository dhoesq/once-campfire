<% @page_title = room_display_name(@room) %>
<% @body_class = "sidebar" %>
<% content_for :head do %>
  <%= turbo_exempts_page_from_preview %>
  <meta name="current-room-id" content="<%= @room.id %>">
<% end %>

<%= render "rooms/show/nav", room: @room %>

<% content_for :sidebar, sidebar_turbo_frame_tag(src: user_sidebar_path) %>

<%= message_area_tag(@room) do %>
  <%= render "messages/template" %>

  <%= render "rooms/pins", room: @room %>

  <%= messages_tag(@room) do %>
    <%= render "rooms/show/invitation", room: @room %>
    <%= render "messages/list", messages: @messages, unread_at: @membership&.unread_at %>
  <% end %>

  <%= turbo_stream_from @room, :messages %>
  <%= button_to_jump_to_newest_message %>
<% end %>

<%# Thread panel: a right-side overlay column. Links with
    data-turbo-frame="thread-panel" navigate the inner frame to the thread view
    and the controller reveals the panel. Starts empty + hidden. %>
<aside id="thread-panel-container" class="thread-panel" data-controller="thread-panel" data-thread-panel-open-class="thread-panel--open" hidden>
  <turbo-frame id="thread-panel" data-thread-panel-target="frame"></turbo-frame>
</aside>

<% if @room.archived? %>
  <%= render "rooms/show/archived_banner", room: @room %>
<% else %>
  <%= render "rooms/show/composer", room: @room %>
<% end %>
