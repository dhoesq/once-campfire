<% @page_title = "Mentions" %>
<% @body_class = "sidebar mentions" %>

<%# Keep the standard turbo_permanent user_sidebar frame so the main nav stays
    live and the badge-dot / rooms-list hooks are preserved. %>
<% content_for :sidebar, sidebar_turbo_frame_tag(src: user_sidebar_path) %>

<% content_for :nav do %>
  <div class="mentions__title flex align-center gap pad-block-start-half">
    <%= tag.div class: "btn btn--reversed btn--faux align-center gap txt-nowrap" do %>
      <%= image_tag "notification-bell-mentions.svg", size: 18, aria: { hidden: "true" } %>
      <span class="overflow-ellipsis">Mentions</span>
      <span class="flex-item-no-shrink"><%= @messages.size %></span>
    <% end %>
  </div>
<% end %>

<div id="message-area" class="message-area">
  <% if @messages.any? %>
    <div id="mentions-results" class="messages mentions__results">
      <%= render @messages %>
    </div>
  <% else %>
    <div class="message-area--empty min-width center">
      <figure class="center pad">
        <%= image_tag "notification-bell-mentions.svg", aria: { hidden: "true" }, class: "colorize--black translucent" %>
      </figure>
      <p class="txt-large txt-subtle center">No mentions yet</p>
    </div>
  <% end %>
</div>
