<%= button_to rooms_directs_path(user_ids: [ user.id ]), class: "direct direct--row align-center gap borderless fill-transparent unpad" do %>
  <span class="direct__avatar flex-item-no-shrink">
    <span class="avatar">
      <%= image_tag fresh_user_avatar_path(user), size: 48, aria: { hidden: "true" } %>
    </span>
  </span>

  <span class="direct__author flex align-center min-width max-width txt-small">
    <span class="txt-nowrap overflow-ellipsis">
      <span class="for-screen-reader">Start a ping with</span>
      <%= user.name.split(' ')[0] %>
    </span>
  </span>
<% end %>
