<% cache membership do %>
  <% members = membership.room.users.without(membership.user).presence || [ membership.user ] %>

  <%= link_to_room membership.room, class: [ "direct direct--row align-center gap", "unread": membership.unread? ], id: dom_id(membership.room, :list),
        data: { sorted_list_number: membership.room.updated_at.to_fs(:epoch) } do %>
    <% if members.many? %>
      <span class="direct__avatar flex-item-no-shrink">
        <span class="avatar__group">
          <% members.first(4).each do |member| %>
            <span class="avatar">
              <%= image_tag fresh_user_avatar_path(member), size: 20, aria: { hidden: "true" } %>
            </span>
          <% end %>
        </span>
      </span>
    <% else %>
      <span class="direct__avatar flex-item-no-shrink">
        <span class="avatar">
          <%= image_tag fresh_user_avatar_path(members.first), size: 48, aria: { hidden: "true" } %>
        </span>
      </span>
    <% end %>

    <span class="direct__author flex align-center min-width max-width txt-small">
      <span class="txt-nowrap overflow-ellipsis">
        <span class="for-screen-reader">Ping with</span>
        <% if members.many? %>
          <%= members.map { |member| member.name.split(' ')[0] }.to_sentence(two_words_connector: ', ', last_word_connector: ', ') %>
        <% else %>
          <%= members.first.name.split(' ')[0] %>
        <% end %>
      </span>
    </span>

    <%= room_star_toggle membership.room, starred: membership.starred? %>
  <% end %>
<% end %>
