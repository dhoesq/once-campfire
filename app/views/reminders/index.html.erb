<% @page_title = "Reminders" %>
<% @body_class = "sidebar reminders" %>

<%# Keep the standard turbo_permanent user_sidebar frame so the main nav stays
    live and the badge-dot / rooms-list hooks are preserved (mirrors bookmarks). %>
<% content_for :sidebar, sidebar_turbo_frame_tag(src: user_sidebar_path) %>

<% content_for :nav do %>
  <div class="reminders__title flex align-center gap pad-block-start-half">
    <%= tag.div class: "btn btn--reversed btn--faux align-center gap txt-nowrap" do %>
      <%= image_tag "notification-bell-alert.svg", size: 18, aria: { hidden: "true" } %>
      <span class="overflow-ellipsis">Reminders</span>
      <span class="flex-item-no-shrink"><%= @reminders.size %></span>
    <% end %>
  </div>
<% end %>

<div id="message-area" class="message-area">
  <% if @reminders.any? %>
    <div id="reminders-list" class="messages reminders__results flex flex-column gap">
      <%= render partial: "reminders/reminder", collection: @reminders, as: :reminder %>
    </div>
  <% else %>
    <div class="message-area--empty min-width center">
      <figure class="center pad">
        <%= image_tag "notification-bell-alert.svg", aria: { hidden: "true" }, class: "colorize--black translucent" %>
      </figure>
      <p class="txt-large txt-subtle center">No reminders set</p>
    </div>
  <% end %>
</div>
